<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <ProjectReference Include="../Dq.Client/Dq.Client.csproj" />
    <Protobuf Include="../../python/dq_python/tests/echo.proto" GrpcServices="None" />
    <Protobuf Include="Fixtures/voice.proto" GrpcServices="None" />
    <None Update="Fixtures/*.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
